# ==============================================================================
# Frontier AI — Real GitHub OAuth 2.0 Environment Configuration
# ==============================================================================

NODE_ENV=development
PORT=3030
BASE_URL=http://localhost:3030

# Secret key used for HMAC signing of blind anonymous voting tokens (minimum 32 bytes hex)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VOTING_SECRET=generate_a_random_64_character_hex_secret_here

# ------------------------------------------------------------------------------
# HOW TO OBTAIN GITHUB OAUTH CREDENTIALS (2 MINUTES):
# 1. Go to your GitHub account: Settings -> Developer Settings -> OAuth Apps
#    Direct Link: https://github.com/settings/developers
# 2. Click "New OAuth App"
# 3. Enter the following details:
#    - Application name: Frontier AI Engineering Platform
#    - Homepage URL: http://localhost:3030
#    - Application description: Internal workspace for Frontier AI team
#    - Authorization callback URL: http://localhost:3030/api/auth/github/callback
# 4. Click "Register application".
# 5. Copy the generated "Client ID" below.
# 6. Click "Generate a new client secret" and copy the secret below.
# ------------------------------------------------------------------------------

GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
